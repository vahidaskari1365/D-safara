generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USERS & AUTH ============

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String?
  email         String?
  avatar        String?
  role          String   @default("STUDENT") // STUDENT | MENTOR | ADMIN
  bio           String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments    Enrollment[]
  submissions    Submission[]
  examAttempts   ExamAttempt[]
  journalEntries TradeJournalEntry[]
  exercises      TradingExercise[]
  orders         Order[]
  tickets        Ticket[]
  sentMessages   Message[]         @relation("sentBy")
  notifications  Notification[]
  sessions       MentorSession[]   @relation("studentSessions")
  mentorSessions MentorSession[]   @relation("mentorSessions")
  planMentorEnrollments   MentoringPlanEnrollment[] @relation("planMentor")
  planStudentEnrollments  MentoringPlanEnrollment[] @relation("planStudent")
  coursesTaught Course[]
  certificates   Certificate[]
  mentorCommissions Commission[]
  transactions   FinancialTransaction[]
  wallet         Wallet?
  reviewComments TradingReviewComment[]
  applications   JobApplication[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// ============ CATALOG ============

model Category {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  courses     Course[]
}

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  longDescription String?
  image         String?
  level         String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  price         Int      @default(0) // Toman
  oldPrice      Int?
  durationHours Int      @default(0)
  isPublished   Boolean  @default(true)
  isFree        Boolean  @default(false)
  rating        Float    @default(4.8)
  studentsCount Int      @default(0)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  mentorId      String?
  mentor        User?     @relation(fields: [mentorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapters      Chapter[]
  enrollments   Enrollment[]
  orderItems    OrderItem[]
  pathCourses   PathCourse[]
  assignments   Assignment[]
  exams         Exam[]
}

model Chapter {
  id       String @id @default(cuid())
  title    String
  order    Int    @default(0)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons  Lesson[]
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  durationMin Int     @default(10)
  isFree      Boolean @default(false)
  order       Int     @default(0)
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  materials   String? // JSON array of file names
}

model LearningPath {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String
  icon        String?
  level       String  @default("BEGINNER")
  audience    String?
  objective   String?
  color       String?
  courses     PathCourse[]
}

model PathCourse {
  id       String       @id @default(cuid())
  order    Int          @default(0)
  pathId   String
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ============ LEARNING ============

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Int      @default(0) // 0-100
  lastLessonId String?
  createdAt   DateTime @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  lessonId String
  completed Boolean @default(false)
  watchedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Assignment {
  id        String   @id @default(cuid())
  title     String
  description String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dueDate   DateTime?
  maxScore  Int      @default(100)
  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  fileUrl      String?
  status       String   @default("SUBMITTED") // SUBMITTED | GRADED | REVISION
  score        Int?
  feedback     String?
  createdAt    DateTime @default(now())
  gradedAt     DateTime?
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  description String?
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  durationMin Int      @default(20)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  questions Question[]
  attempts  ExamAttempt[]
}

model Question {
  id      String @id @default(cuid())
  text    String
  options String // JSON array of 4 options
  answer  Int    // index of correct option
  score   Int    @default(10)
  examId  String
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Float    @default(0)
  maxScore  Float    @default(0)
  answers   String   // JSON
  createdAt DateTime @default(now())
}

// ============ TRADING ============

model TradeJournalEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  direction   String   // LONG | SHORT
  entryPrice  Float
  exitPrice   Float
  lotSize     Float    @default(0.1)
  stopLoss    Float?
  takeProfit  Float?
  pnl         Float
  pnlPercent  Float    @default(0)
  status      String   @default("WIN") // WIN | LOSS | BREAKEVEN
  setup       String?  // strategy / setup name
  notes       String?
  emotion     String?
  tradeDate   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model TradingExercise {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  timeframe   String   @default("1H")
  taskTitle   String
  description String?
  snapshot    String?  // JSON chart data snapshot
  analysis    String?  // student notes / analysis
  checklist   String?  // JSON
  status      String   @default("PENDING") // PENDING | REVIEWED | RETURNED
  mentorScore Int?
  mentorFeedback String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewComments TradingReviewComment[]
}

model TradingReviewComment {
  id        String   @id @default(cuid())
  exerciseId String
  exercise  TradingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// ============ MENTORING ============

model MentoringPlan {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String
  price       Int     @default(0)
  durationDays Int    @default(30)
  features    String  // JSON array
  sessionsPerWeek Int @default(2)
  isActive    Boolean @default(true)

  enrollments MentoringPlanEnrollment[]
}

model MentoringPlanEnrollment {
  id        String   @id @default(cuid())
  planId    String
  plan      MentoringPlan @relation(fields: [planId], references: [id])
  mentorId  String
  mentor    User     @relation("planMentor", fields: [mentorId], references: [id])
  userId    String?  // null = public application
  user      User?    @relation("planStudent", fields: [userId], references: [id])
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model MentorSession {
  id        String   @id @default(cuid())
  title     String
  studentId String
  student   User     @relation("studentSessions", fields: [studentId], references: [id])
  mentorId  String
  mentor    User     @relation("mentorSessions", fields: [mentorId], references: [id])
  startTime DateTime
  durationMin Int    @default(60)
  status    String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  meetingUrl String?
  notes     String?
  createdAt DateTime @default(now())
}

model WeeklyReport {
  id        String   @id @default(cuid())
  studentId String
  mentorId  String
  weekLabel String
  summary   String
  progress  Int      @default(0)
  createdAt DateTime @default(now())
}

// ============ COMMERCE & FINANCE ============

model Product {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String
  price       Int     @default(0)
  oldPrice    Int?
  type        String  @default("DIGITAL") // DIGITAL | BOOK | INDICATOR
  image       String?
  isActive    Boolean @default(true)
  orderItems  OrderItem[]
}

model Order {
  id          String   @id @default(cuid())
  orderNo     String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  totalAmount Int      @default(0)
  discount    Int      @default(0)
  status      String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  paymentMethod String @default("ZARINPAL")
  refId       String?
  couponCode  String?
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course? @relation(fields: [courseId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  title     String
  price     Int
  quantity  Int     @default(1)
}

model Wallet {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  balance   Int    @default(0)
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  type        String   // DEPOSIT | PURCHASE | REFUND | COMMISSION | WITHDRAWAL | SETTLEMENT
  amount      Int
  description String
  refId       String?
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  percentOff  Int      @default(10)
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

// ============ MENTOR COMMISSIONS ============

model Commission {
  id        String   @id @default(cuid())
  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id])
  orderId   String?
  amount    Int
  percent   Int      @default(30)
  status    String   @default("PENDING") // PENDING | SETTLED
  createdAt DateTime @default(now())
}

// ============ SUPPORT & MESSAGING ============

model Ticket {
  id        String   @id @default(cuid())
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  category  String   @default("GENERAL")
  priority  String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status    String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  createdAt DateTime @default(now())

  messages  TicketMessage[]
}

model TicketMessage {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body     String
  isStaff  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation("sentBy", fields: [senderId], references: [id])
  receiverId   String
  conversationId String
  body         String
  attachment   String?
  readAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([conversationId])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String?
  type      String   @default("SYSTEM") // SYSTEM | COURSE | ASSIGNMENT | SESSION | PAYMENT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ CMS ============

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  cover       String?
  category    String   @default("تحلیل بازار")
  tags        String?
  authorName  String   @default("تیم دی‌صفارا")
  readTimeMin Int      @default(5)
  isPublished Boolean  @default(true)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String?
  content   String
  rating    Int     @default(5)
  avatar    String?
  isActive  Boolean @default(true)
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  category String @default("عمومی")
  order    Int    @default(0)
}

model FreeResource {
  id          String @id @default(cuid())
  title       String
  description String
  type        String @default("PDF") // PDF | VIDEO | CHECKLIST
  size        String?
  downloads   Int    @default(0)
  url         String?
}

// ============ RECRUITMENT ============

model JobPosting {
  id          String   @id @default(cuid())
  title       String
  description String
  department  String
  type        String   @default("FULL_TIME")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model JobApplication {
  id        String   @id @default(cuid())
  postingId String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String
  phone     String
  resumeText String?
  status    String   @default("PENDING") // PENDING | INTERVIEW | ACCEPTED | REJECTED
  interviewAt DateTime?
  createdAt DateTime @default(now())
}

// ============ CERTIFICATES ============

model Certificate {
  id        String   @id @default(cuid())
  serial    String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String?
  title     String
  issuedAt  DateTime @default(now())
}

// ============ SYSTEM ============

model AuditLog {
  id        String   @id @default(cuid())
  actorName String
  action    String
  entity    String
  detail    String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
